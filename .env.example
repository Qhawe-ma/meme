# Copy to .env.local. Never commit real secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

# The app connects as app_rw. Migrations connect as the superuser.
# Create both with: npm run db:migrate
DATABASE_URL=postgres://app_rw:mm_app_dev_only@127.0.0.1:5432/meme_market
MIGRATOR_DATABASE_URL=postgres://mm_migrator:mm_dev_only@127.0.0.1:5432/meme_market
APP_DB_PASSWORD=mm_app_dev_only

# Optional. The web process runs the invariant check itself on a single host.
# REDIS_URL=redis://127.0.0.1:6379

# Email. If SMTP_HOST is unset, messages are printed to the server console.
# Set EMAIL_CAPTURE=true to also store them in email_messages (used by local tests).
# Mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=1025 and open http://127.0.0.1:8025
EMAIL_FROM=Meme Market <noreply@localhost>
EMAIL_CAPTURE=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Comma-separated emails that become admin on signup.
# ADMIN_EMAILS=you@example.com

# Pepper for IP hashes. Change this before any real deployment.
IP_PEPPER=dev-pepper-change-me

# Optional alerts when the ledger invariant fails.
# ALERT_WEBHOOK_URL=

# Optional Cloudflare Turnstile. If unset, the human check is skipped.
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# POPIA contact shown on the privacy page.
INFORMATION_OFFICER_EMAIL=privacy@example.com

# Set to beta before the first migration to seed the small economy preset.
# ECONOMY_PRESET=default

# Set TRUST_PROXY=1 only behind your own reverse proxy.
# TRUST_PROXY=
